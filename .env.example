# --- Jev ------------------------------------------------------------------------
# Fill in ONE of these keys, in your private .env file, never in this file.
# Leave them all empty to run every project against the offline mock.
#
# Option A: a TypeSafe key (https://typesafe.ai, console -> API keys)
TYPESAFE_API_KEY=
# Option B: an OpenRouter key (starts with sk-or-), https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Option C: a Vercel AI Gateway key (starts with vck_)
AI_GATEWAY_API_KEY=
#
# JEV_PROVIDER=              # typesafe | openrouter | vercel | mock (default: first key found, in the order above)
# JEV_MODEL=                 # default: jev-latest / typesafe/jev-1.13 / typesafe-ai/jev
# JEV_MOCK=1                 # force the offline mock even when a key is set

# --- Claude (optional) --------------------------------------------------------
# Used only where the video uses an LLM to *write* text: composing memory
# answers (project 2) and generating title ideas (project 3).
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# --- Project 1: voice browser -------------------------------------------------
# HEADLESS=1                 # run the controlled browser without a window
# CHROMIUM_PATH=             # use an existing Chromium/Chrome binary

# --- Project 2: memory ---------------------------------------------------------
# MEMORY_DIR=./projects/02-memory/sample-memory   # point at your own notes folder

# --- Project 3: YouTube predictor ---------------------------------------------
# YOUTUBE_API_KEY=           # only needed for `npm run youtube:fetch`
